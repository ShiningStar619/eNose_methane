AUTHOR = {Guan, Sheng and Qi, Zhijuan and Li, Sirui and Du, Sicheng and Xu, Dan},
TITLE = {Effects of Rice Root Development and Rhizosphere Soil on Methane Emission in Paddy Fields},
JOURNAL = {Plants},
VOLUME = {13},
YEAR = {2024},
